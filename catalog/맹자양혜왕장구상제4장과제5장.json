    "word": [],
    "sentence": [
      {
        "id": "s1",
        "text": "梁惠王이 曰寡人이 願安承敎노이다",
        "reading": "양혜왕이 왈 과인이 원안승교노이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s2",
        "text": "孟子ㅣ對曰殺人以梃與刃이 有以異乎ㅣ잇가 曰無以異也ㅣ니이다",
        "reading": "맹자ㅣ 대왈 살인이정여인이 유이이호ㅣ잇가 왈 무이이야ㅣ니이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s3",
        "text": "以刃與政이 有以異乎ㅣ잇가 曰無以異也ㅣ니이다",
        "reading": "이인여정이 유이이호ㅣ잇가 왈 무이이야ㅣ니이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s4",
        "text": "曰庖有肥肉며 廐有肥馬ㅣ오 民有飢色며 野有餓莩ㅣ면",
        "reading": "왈 포유비육며 구유비마ㅣ오 민유기색며 야유아표ㅣ면",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s5",
        "text": "此 率獸而食人也ㅣ니이다",
        "reading": "차 솔수이식인야ㅣ니이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s6",
        "text": "獸相食을 且人이 惡之니",
        "reading": "수상식을 차인이 오지니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s7",
        "text": "爲民父母ㅣ라 行政호 不免於率獸而食人이면",
        "reading": "위민부모ㅣ라 행정호 불면어솔수이식인이면",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s8",
        "text": "惡在其爲民父母也ㅣ리잇고",
        "reading": "오재기위민부모야ㅣ리잇고",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s9",
        "text": "仲尼曰始作俑者ㅣ 其無後乎인뎌시니",
        "reading": "중니왈 시작용자ㅣ 기무후호인뎌시니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s10",
        "text": "爲其象人而用之也ㅣ시니 如之何其使斯民飢而死也ㅣ리잇고",
        "reading": "위기상인이용지야ㅣ시니 여지하기사사민기이사야ㅣ리잇고",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s11",
        "text": "梁惠王이 曰晉國이 天下애 莫强焉 叟之所知也ㅣ라",
        "reading": "양혜왕이 왈 진국이 천하애 막강언 수지소지야ㅣ라",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s12",
        "text": "及寡人之身야 東敗於齊예 長子ㅣ死焉고",
        "reading": "급과인지신야 동패어제예 장자ㅣ 사언고",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s13",
        "text": "西喪地於秦七百里고 南辱於楚니",
        "reading": "서상지어진칠백리고 남욕어초니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s14",
        "text": "寡人이 恥之야 願比死者야 一洒之노니",
        "reading": "과인이 치지야 원비사자야 일쇄지노니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s15",
        "text": "如之何則可ㅣ니잇고",
        "reading": "여지하즉가ㅣ니잇고",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s16",
        "text": "孟子ㅣ對曰地方百里而可以王이니이다",
        "reading": "맹자ㅣ 대왈 지방백리이가이왕이니이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s17",
        "text": "王如施仁政於民샤 省刑罰시며 薄稅斂시면",
        "reading": "왕여시인정어민샤 생형벌시며 박세렴시면",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s18",
        "text": "深耕易耨고 壯者ㅣ以暇日로 修其孝悌忠信야",
        "reading": "심경이누고 장자ㅣ 이하일로 수기효제충신야",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s19",
        "text": "入以事其父兄며 出以事其長上리니",
        "reading": "입이사기부형며 출이사기장상리니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s20",
        "text": "可使制梃야 以撻秦楚之堅甲利兵矣리이다",
        "reading": "가사제정야 이달진초지견갑리병의리이다",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s21",
        "text": "彼ㅣ奪其民時야 使不得耕耨야 以養其父母면",
        "reading": "피ㅣ 탈기민시야 사불득경누야 이양기부모면",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s22",
        "text": "父母ㅣ凍餓며 兄弟妻子ㅣ離散리니",
        "reading": "부모ㅣ 동아며 형제처자ㅣ 이산리니",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s23",
        "text": "彼ㅣ陷溺其民이어든 王이 往而征之시면 夫誰與王敵이리잇고",
        "reading": "피ㅣ 함닉기민이어든 왕이 왕이정지시면 부수여왕적이리잇고",
        "meaning": "",
        "note": ""
      },
      {
        "id": "s24",
        "text": "故로 曰仁者 無敵이라니 王請勿疑쇼셔",
        "reading": "고로 왈 인자 무적이라니 왕청물의쇼셔",
        "meaning": "",
        "note": ""
      }
    ],
    "paragraph": []
  }
}
